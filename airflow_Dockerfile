FROM apache/airflow:2.9.1-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN pip install --no-cache-dir \
    clickhouse-connect==0.7.16 \
    httpx==0.27.0 \
    pyarrow==16.1.0 \
    pandas==2.2.2 \
    faker==25.8.0 \
    numpy==1.26.4
