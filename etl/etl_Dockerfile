FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia todo etl/ → /app  (bronze/, silver/, gold/, utils/, dags/, main.py)
COPY etl/ .

RUN mkdir -p /app/parquet_stage

# /app está en WORKDIR → Python puede importar bronze, silver, gold, utils directamente
CMD ["python", "main.py"]
